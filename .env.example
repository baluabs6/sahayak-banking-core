APP_NAME=sahayak-banking-core
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DSN=postgresql+asyncpg://sahayak_user:sahayak_pass@localhost:5432/sahayak_db

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=sahayak_nosql

# --- Redis (cache + rate limiting; not a system of record) ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_CREDIT_SCORE_SECONDS=600
CACHE_TTL_RAG_ANSWER_SECONDS=1800
RATE_LIMIT_ASSISTANT_PER_MINUTE=10

# --- AWS ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_KYC_DOCS=sahayak-kyc-documents
S3_BUCKET_DATA_LAKE=sahayak-data-lake
DYNAMODB_TABLE_SESSIONS=sahayak-user-sessions
DYNAMODB_TABLE_FRAUD_SIGNALS=sahayak-fraud-signals
SNS_TOPIC_FRAUD_ALERTS=arn:aws:sns:ap-south-1:000000000000:fraud-alerts
SNS_TOPIC_LOAN_NOTIFICATIONS=arn:aws:sns:ap-south-1:000000000000:loan-notifications
CLOUDWATCH_NAMESPACE=SahayakBankingCore/Backend

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- AI / LLM: choose one as default (per-request override is also supported) ---
# Options: anthropic | openai | ollama | langchain_auto
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- RAG ---
VECTOR_STORE_BACKEND=faiss
EMBEDDING_PROVIDER=anthropic

# --- GCP DR ---
GCP_PROJECT_ID=
GCP_DR_REGION=asia-south1
