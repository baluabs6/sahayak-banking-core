APP_NAME=sahayak-banking-core
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DSN=postgresql+asyncpg://sahayak_user:sahayak_pass@localhost:5432/sahayak_db

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=sahayak_nosql

# --- Redis (cache + rate limiting; not a system of record) ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_CREDIT_SCORE_SECONDS=600
CACHE_TTL_RAG_ANSWER_SECONDS=1800
RATE_LIMIT_ASSISTANT_PER_MINUTE=10

# --- AWS ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_KYC_DOCS=sahayak-kyc-documents
S3_BUCKET_DATA_LAKE=sahayak-data-lake
DYNAMODB_TABLE_SESSIONS=sahayak-user-sessions
DYNAMODB_TABLE_FRAUD_SIGNALS=sahayak-fraud-signals
SNS_TOPIC_FRAUD_ALERTS=arn:aws:sns:ap-south-1:000000000000:fraud-alerts
SNS_TOPIC_LOAN_NOTIFICATIONS=arn:aws:sns:ap-south-1:000000000000:loan-notifications
CLOUDWATCH_NAMESPACE=SahayakBankingCore/Backend

# --- Auth ---
# In staging/production the app REFUSES TO START unless this is >=32 chars
# and not a default value — see app/config.py::validate_production_config.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=14
# Local/dev-only OTP accepted by /api/v1/auth/login. Never used outside
# ENVIRONMENT=local — see app/core/security.py::verify_login_otp.
DEV_FALLBACK_OTP=000000
# Required (>=24 chars) in staging/production to issue analyst/admin tokens
# via /api/v1/auth/internal-token. Leave unset in production until a real
# SSO/Cognito-group-based issuance flow replaces this bootstrap mechanism.
INTERNAL_ADMIN_BOOTSTRAP_KEY=

# --- Rate limiting (per caller, per route) ---
RATE_LIMIT_DEFAULT_PER_MINUTE=30
RATE_LIMIT_TRANSACTIONS_PER_MINUTE=20

# --- AI / LLM: choose one as default (per-request override is also supported) ---
# Options: anthropic | openai | ollama | gemini | bedrock | langchain_auto
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- RAG ---
VECTOR_STORE_BACKEND=faiss
EMBEDDING_PROVIDER=anthropic
# Hybrid dense+sparse retrieval (FAISS + BM25 via EnsembleRetriever).
USE_HYBRID_RETRIEVAL=false
HYBRID_DENSE_WEIGHT=0.5

# --- GCP DR ---
GCP_PROJECT_ID=
GCP_DR_REGION=asia-south1
